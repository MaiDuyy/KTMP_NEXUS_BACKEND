{
    "name": "group-service",
    "version": "1.0.0",
    "description": "Group management service for OTT Chat",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "proto:gen": "grpc_tools_node_protoc --ts_proto_out=./src/grpc/generated --ts_proto_opt=outputServices=generic-definitions,outputServices=default,env=node,esModuleInterop=true --proto_path=./proto ./proto/group.proto"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@ott/shared": "file:../../packages/shared",
        "@prisma/client": "^5.20.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "livekit-server-sdk": "^2.15.1",
        "nats": "^2.28.2",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.3",
        "grpc-tools": "^1.13.1",
        "jest": "^29.7.0",
        "prisma": "^5.20.0",
        "protoc": "^34.0.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.2",
        "ts-proto": "^2.11.6",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0"
    },
    "jest": {
        "preset": "ts-jest/presets/default-esm",
        "testEnvironment": "node",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "useESM": true
                }
            ]
        },
        "setupFilesAfterEnv": [
            "<rootDir>/src/__tests__/setup.ts"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "src/services/**/*.ts",
            "!src/**/*.d.ts"
        ]
    }
}
