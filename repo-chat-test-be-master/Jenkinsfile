pipeline {
    agent any
    
    environment {
        DOCKER_COMPOSE_VERSION = '2.24.0'
        NODE_VERSION = '20'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo '📥 Code checked out successfully'
            }
        }
        
        stage('Build') {
            steps {
                echo '🔨 Building Docker images...'
                sh 'docker-compose build --parallel'
            }
        }
        
        stage('Start Services') {
            steps {
                echo '🚀 Starting services...'
                sh 'docker-compose up -d'
                // Wait for services to be ready
                sh 'sleep 30'
            }
        }
        
        stage('Health Check') {
            steps {
                echo '🏥 Running health checks...'
                script {
                    def services = [
                        'http://localhost:3000/healthz',  // API Gateway
                        'http://localhost:3010/healthz',  // Auth Service
                    ]
                    
                    services.each { url ->
                        sh "curl -f ${url} || exit 1"
                    }
                }
                echo '✅ All services are healthy!'
            }
        }
        
        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                sh 'cd services/api-gateway && npm test || true'
                sh 'cd services/auth-service && npm test || true'
            }
        }
        
        stage('Smoke Test') {
            steps {
                echo '💨 Running smoke tests...'
                script {
                    // Test Rate Limiter
                    sh 'curl -f http://localhost:3000/demo/limited'
                    
                    // Test Redis CRUD
                    sh '''
                        curl -X POST http://localhost:3000/demo/profiles/cache \
                          -H "Content-Type: application/json" \
                          -d '{"userId":"jenkins-test","data":{"name":"Jenkins Test"}}'
                    '''
                    
                    // Cleanup
                    sh 'curl -X DELETE http://localhost:3000/demo/profiles/cache/jenkins-test'
                }
                echo '✅ Smoke tests passed!'
            }
        }
    }
    
    post {
        always {
            echo '🧹 Cleaning up...'
            sh 'docker-compose down -v || true'
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
