# Docker Environment Variables
# Copy this to .env.docker and fill in your values

# Database
POSTGRES_USER=ott_user
POSTGRES_PASSWORD=ott_password
POSTGRES_DB=ott_chat
DATABASE_URL=postgresql://ott_user:ott_password@postgres:5432/ott_chat

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3002

# Node
NODE_ENV=development

# AWS S3 (Optional - for file service)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# S3_BUCKET=ott-chat-files
