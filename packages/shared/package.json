{
    "name": "@ott/shared",
    "version": "1.0.0",
    "description": "Shared types, schemas, and utilities for OTT Chat microservices",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "jest",
        "clean": "rimraf dist"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/types/index.js"
        },
        "./schemas": {
            "types": "./dist/schemas/index.d.ts",
            "default": "./dist/schemas/index.js"
        },
        "./events": {
            "types": "./dist/events/index.d.ts",
            "default": "./dist/events/index.js"
        },
        "./dto": {
            "types": "./dist/dto/index.d.ts",
            "default": "./dist/dto/index.js"
        },
        "./utils": {
            "types": "./dist/utils/index.d.ts",
            "default": "./dist/utils/index.js"
        }
    },
    "dependencies": {
        "express": "^5.0.0",
        "jsonwebtoken": "^9.0.2",
        "uuid": "^11.0.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "rimraf": "^6.0.0",
        "typescript": "^5.6.0"
    }
}