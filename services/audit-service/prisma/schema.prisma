generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= AUDIT SERVICE MODELS =================
// Enterprise audit logging for security and compliance

// Audit log severity
enum AuditSeverity {
  INFO     // Normal operations
  WARNING  // Potential issues
  CRITICAL // Security events
  ALERT    // Immediate attention needed
}

// Audit log categories
enum AuditCategory {
  AUTH           // Login, logout, token refresh
  USER_MGMT      // User CRUD
  ROLE_MGMT      // Role/permission changes
  DATA_ACCESS    // Document/chat access
  DATA_MODIFY    // Document/message changes
  DATA_DELETE    // Deletions
  ADMIN          // Admin operations
  SECURITY       // Security events
  AI             // AI/RAG interactions
  EXPORT         // Data exports
  SYSTEM         // System events
}

// Main audit log
model AuditLog {
  id          String   @id @default(uuid())
  
  // Actor
  userId      String?  // Who performed the action (null for system)
  userEmail   String?  // Denormalized for queries
  userRole    String?  // Role at time of action
  
  // Action
  category    AuditCategory
  action      String   // e.g., "login", "create", "delete"
  severity    AuditSeverity @default(INFO)
  
  // Target
  resource    String   // e.g., "user", "document", "chat"
  resourceId  String?  // ID of affected resource
  
  // Context
  orgId       String?  // Organization scope
  workspaceId String?  // Workspace scope
  
  // Details
  details     Json?    // Action-specific data
  oldValue    Json?    // For modifications
  newValue    Json?    // For modifications
  
  // Request context
  ipAddress   String?
  userAgent   String?
  requestId   String?  // Correlation ID
  
  // Result
  success     Boolean  @default(true)
  errorCode   String?
  errorMessage String?
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([severity])
  @@index([orgId])
  @@map("audit_log")
}

// DM access log (special tracking for admin reads)
model DMAccessLog {
  id          String   @id @default(uuid())
  accessedBy  String   // Admin who accessed
  accessedAt  DateTime @default(now())
  
  // Target conversation
  conversationId String
  participant1Id String  // One participant
  participant2Id String  // Other participant
  
  // Justification
  reason      String   // Required explanation
  approvedBy  String?  // If requires approval
  
  // Session info
  ipAddress   String?
  sessionId   String?
  
  messagesViewed Int      @default(0)
  timeSpent      Int      @default(0) // Seconds

  @@index([accessedBy])
  @@index([conversationId])
  @@index([accessedAt])
  @@map("dm_access_log")
}

// Security alert
model SecurityAlert {
  id          String   @id @default(uuid())
  
  type        String   // e.g., "suspicious_login", "permission_escalation"
  severity    AuditSeverity @default(WARNING)
  
  userId      String?  // Related user
  
  details     Json
  
  // Resolution
  status      String   @default("open") // open, investigating, resolved, false_positive
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
  @@map("security_alert")
}

// Compliance report
model ComplianceReport {
  id          String   @id @default(uuid())
  
  type        String   // e.g., "monthly_access", "dm_audit"
  periodStart DateTime
  periodEnd   DateTime
  
  generatedBy String
  generatedAt DateTime @default(now())
  
  // Report data
  summary     Json
  filePath    String?  // If exported to file
  
  @@index([type])
  @@index([generatedAt])
  @@map("compliance_report")
}
