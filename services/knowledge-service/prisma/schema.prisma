generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= KNOWLEDGE SERVICE MODELS =================
// Document management with ACL for Permission-Aware RAG

// Document security classification
enum Classification {
  PUBLIC         // Anyone can access
  INTERNAL       // All employees
  CONFIDENTIAL   // Department/Group restricted  
  RESTRICTED     // Named individuals only
  TOP_SECRET     // Admin only
}

// Document processing status
enum DocumentStatus {
  PENDING        // Uploaded, not processed
  PROCESSING     // Being parsed/chunked
  INDEXED        // Ready for RAG
  FAILED         // Processing failed
  ARCHIVED       // No longer in active index
}

// Collection - Logical grouping of documents
model Collection {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  ownerId     String   // Creator userId
  
  // Default classification for new documents
  defaultClassification Classification @default(INTERNAL)
  
  // AI settings
  isAIEnabled   Boolean @default(true)  // Allow AI to use this collection
  ragPriority   Int     @default(5)     // 1-10, higher = more important
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  acl       CollectionACL[]
  documents Document[]

  @@index([ownerId])
  @@index([isActive, isAIEnabled])
  @@map("collection")
}

// Collection-level ACL
model CollectionACL {
  id           String   @id @default(uuid())
  collectionId String
  
  // Access target (one of these should be set)
  userId       String?  // Individual user
  groupId      String?  // Group from RBAC
  departmentId String?  // Department from RBAC
  roleId       String?  // Role from RBAC (e.g., all EMPLOYEES)
  
  // Permission level
  canRead      Boolean  @default(true)
  canWrite     Boolean  @default(false)
  canDelete    Boolean  @default(false)
  canAdmin     Boolean  @default(false)  // Can modify ACL
  
  grantedBy    String   // Who granted this access
  grantedAt    DateTime @default(now())
  expiresAt    DateTime? // Optional expiration

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId, groupId, departmentId, roleId])
  @@index([collectionId])
  @@index([userId])
  @@map("collection_acl")
}

// Document - Individual knowledge item
model Document {
  id           String   @id @default(uuid())
  collectionId String
  
  // Metadata
  title        String
  description  String?
  fileName     String   // Original filename
  fileType     String   // MIME type
  fileSize     Int      // Bytes
  filePath     String   // Storage path
  fileHash     String?  // SHA256 for deduplication
  
  // Source tracking
  sourceType   String   @default("upload") // upload, gdrive, sharepoint, confluence
  sourceUrl    String?  // Original URL if synced from external source
  sourceId     String?  // ID in external system
  
  // Classification & ACL
  classification Classification @default(INTERNAL)
  
  // Processing
  status       DocumentStatus @default(PENDING)
  chunkCount   Int      @default(0)
  processedAt  DateTime?
  errorMessage String?
  
  // Ownership
  uploadedBy   String   // userId
  approvedBy   String?  // userId who approved for AI (if required)
  approvedAt   DateTime?
  
  // Versioning
  version      Int      @default(1)
  parentId     String?  // Previous version
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]
  acl        DocumentACL[]
  parent     Document?  @relation("DocumentVersions", fields: [parentId], references: [id])
  versions   Document[] @relation("DocumentVersions")

  @@index([collectionId])
  @@index([status])
  @@index([uploadedBy])
  @@index([classification])
  @@index([fileHash])
  @@map("document")
}

// Document-level ACL (overrides collection ACL)
model DocumentACL {
  id         String   @id @default(uuid())
  documentId String
  
  // Access target
  userId       String?
  groupId      String?
  departmentId String?
  
  canRead    Boolean  @default(true)
  canWrite   Boolean  @default(false)
  
  grantedBy  String
  grantedAt  DateTime @default(now())
  expiresAt  DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId, groupId, departmentId])
  @@index([documentId])
  @@map("document_acl")
}

// Document chunks for RAG
model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  
  // Chunk content
  content    String   @db.Text
  chunkIndex Int      // Position in document
  
  // Metadata for retrieval
  startPage  Int?     // For PDFs
  endPage    Int?
  heading    String?  // Section heading
  
  // Token count for context window management
  tokenCount Int      @default(0)
  
  // Embedding stored in Spring AI's vector store
  // We only keep a reference here
  embeddingId String? // ID in vector store
  
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([embeddingId])
  @@map("document_chunk")
}

// Knowledge source for scheduled sync
model KnowledgeSource {
  id          String   @id @default(uuid())
  name        String
  type        String   // gdrive, sharepoint, confluence, notion
  
  // Connection config (encrypted in production)
  config      Json     // { apiKey, folderId, siteUrl, etc. }
  
  // Target collection
  collectionId String?
  
  // Sync settings
  syncEnabled  Boolean @default(true)
  syncSchedule String? // Cron expression
  lastSyncAt   DateTime?
  lastSyncStatus String?
  
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("knowledge_source")
}
