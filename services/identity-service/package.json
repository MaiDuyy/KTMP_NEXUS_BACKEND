{
    "name": "identity-service",
    "version": "1.0.0",
    "description": "Unified Identity Service (Auth + UserOrg + RBAC) for OTT Chat",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --max-old-space-size=256  src/index.ts",
        "build": "npm run prisma:generate && tsc",
        "start": "node --max-old-space-size=256  dist/index.js",
        "test": "vitest",
        "prisma:generate": "prisma generate --schema=prisma/auth.prisma && prisma generate --schema=prisma/userorg.prisma && prisma generate --schema=prisma/rbac.prisma",
        "prisma:migrate:auth": "prisma migrate dev --schema=prisma/auth.prisma",
        "prisma:migrate:userorg": "prisma migrate dev --schema=prisma/userorg.prisma",
        "prisma:migrate:rbac": "prisma migrate dev --schema=prisma/rbac.prisma",
        "prisma:deploy": "prisma db push --schema=prisma/auth.prisma --accept-data-loss && prisma db push --schema=prisma/userorg.prisma --accept-data-loss && prisma db push --schema=prisma/rbac.prisma --accept-data-loss",
        "prisma:seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@ott/shared": "file:../../packages/shared",
        "@prisma/client": "^5.20.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "jsonwebtoken": "^9.0.2",
        "nats": "^2.28.2",
        "node-cron": "^4.2.1",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "uuid": "^9.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.19.7",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^9.0.8",
        "pino-pretty": "^13.1.3",
        "prisma": "^5.20.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0",
        "vitest": "^2.1.5"
    }
}
