# Identity Service - Unified (Auth + UserOrg + RBAC)
PORT=3010
NODE_ENV=development
FRONTEND_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002

# Database URLs (3 separate schemas)
AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=auth
USERORG_DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=userorg
RBAC_DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=rbac

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRY=30m

# NATS
NATS_URL=nats://localhost:4222

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@example.com

# gRPC
IDENTITY_GRPC_PORT=50051
IDENTITY_GRPC_HOST=localhost:50051
