LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
LIVEKIT_AI_PARTICIPANT_NAME=Nexus AI
LIVEKIT_CONNECT_TIMEOUT_MS=15000
LIVEKIT_PLAYOUT_TIMEOUT_MS=70000

# Batch voice pipeline
MEETING_VOICE_ENABLED=false
VOICE_METRICS_ENABLED=false
VOICE_TURN_TOKEN_SECRET=must-match-ws-gateway-turn-token-secret
VOICE_CONTROL_INTERNAL_URL=http://localhost:3001/internal/voice
VOICE_INTERNAL_SERVICE_KEY=must-match-ws-gateway-internal-service-key
MEETING_AI_INTERNAL_URL=http://localhost:8080/internal/meeting-ai
MEETING_AI_INTERNAL_SERVICE_KEY=must-match-ai-knowledge-internal-service-key
VOICE_PIPELINE_TIMEOUT_MS=150000
VOICE_MEETING_CLEANUP_TIMEOUT_MS=30000

# Streaming input (keep disabled until public WebSocket ingress is ready)
VOICE_STREAMING_ENABLED=false
VOICE_STREAM_ALLOWED_ORIGINS=http://localhost:3000
VOICE_STREAM_AUTH_TIMEOUT_MS=5000
VOICE_STREAM_IDLE_TIMEOUT_MS=15000
VOICE_STREAM_MAX_DURATION_MS=60000
VOICE_STREAM_MAX_QUEUED_BYTES=262144

# Google Cloud STT/TTS (uses ADC/service account credentials)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_STT_MODEL=chirp_3
GOOGLE_STT_LANGUAGE=vi-VN
GOOGLE_STT_TIMEOUT_MS=15000
GOOGLE_STREAMING_STT_TIMEOUT_MS=70000
GOOGLE_STREAMING_STT_LOCATION=us
GOOGLE_STREAMING_STT_MODEL=chirp_3
GOOGLE_STREAMING_STT_PHRASES=
GOOGLE_TTS_VOICE=vi-VN-Chirp3-HD-Charon
GOOGLE_TTS_AUDIO_ENCODING=LINEAR16
GOOGLE_TTS_TIMEOUT_MS=15000

# Disabled by default until the Phase 3 streaming path is released. Google
# streaming TTS produces headerless mono PCM, not a WAV response.
VOICE_STREAMING_TTS_ENABLED=false
GOOGLE_STREAMING_TTS_LOCATION=asia-southeast1
GOOGLE_STREAMING_TTS_VOICE=vi-VN-Chirp3-HD-Charon
GOOGLE_STREAMING_TTS_SAMPLE_RATE_HERTZ=24000
GOOGLE_STREAMING_TTS_FIRST_AUDIO_TIMEOUT_MS=10000
GOOGLE_STREAMING_TTS_IDLE_AUDIO_TIMEOUT_MS=15000
GOOGLE_STREAMING_TTS_TOTAL_TIMEOUT_MS=60000
GOOGLE_STREAMING_TTS_MAX_QUEUED_BYTES=524288
VOICE_STREAMING_TTS_SENTENCE_MINIMUM_CHARS=24
VOICE_STREAMING_TTS_SENTENCE_TARGET_CHARS=160
VOICE_STREAMING_TTS_SENTENCE_MAXIMUM_CHARS=280
VOICE_STREAMING_TTS_SENTENCE_FLUSH_TIMEOUT_MS=800
