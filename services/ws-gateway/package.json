{
    "name": "ws-gateway",
    "version": "1.0.0",
    "description": "WebSocket Gateway for OTT Chat realtime messaging",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --max-old-space-size=256  src/index.ts",
        "build": "tsc",
        "start": "node --max-old-space-size=256  dist/index.js",
        "test": "tsx --test src/**/*.test.ts"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@ott/shared": "file:../../packages/shared",
        "@prometheus-io/client": "^0.16.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "axios": "^1.15.1",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "livekit-server-sdk": "^2.15.1",
        "nats": "^2.28.2",
        "pino": "^9.4.0",
        "socket.io": "^4.7.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.0.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0"
    }
}
