# Server Config
PORT=3001
CORS_ORIGIN=http://localhost:3000

# LiveKit
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=wss://your-livekit-url

# Security
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRY=30m
INTERNAL_SERVICE_SECRET=your_internal_secret

# AI Voice turn control (secrets required in production when enabled)
MEETING_VOICE_ENABLED=false
MEETING_VOICE_ALLOWED_WORKSPACE_IDS=
VOICE_METRICS_ENABLED=false
VOICE_TURN_TOKEN_SECRET=generate-a-strong-random-secret
VOICE_TURN_TOKEN_TTL_SECONDS=120
VOICE_PUBLIC_API_URL=http://localhost:3000/api
VOICE_PUBLIC_STREAM_URL=
VOICE_INTERNAL_SERVICE_KEY=generate-a-separate-strong-random-secret
VOICE_SERVICE_INTERNAL_URL=http://localhost:3035/internal/voice

# Infrastructure
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# Service URLs
MESSAGING_SERVICE_URL=http://localhost:3020
SPRING_AI_URL=http://localhost:8080

# gRPC
MESSAGING_GRPC_HOST=localhost
MESSAGING_GRPC_PORT=50052
