generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id           String    @id @default(uuid())
  userId       String
  chatId       String?
  type         FileType  @default(CHAT)
  mimeType     String
  originalName String?
  url          String
  publicId     String?
  size         Int
  createdAt    DateTime  @default(now())

  // RAG Document fields
  classification     String?   // PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED
  department         String?
  project            String?
  tags               String[]  @default([])
  processingStatus   String?   // PENDING, PROCESSING, READY, ERROR
  collectionId       String?   // For knowledge-service integration

  @@index([userId])
  @@index([chatId])
  @@index([type])
  @@index([collectionId])
  @@map("file")
}

enum FileType {
  AVATAR
  CHAT
  GROUP_AVATAR
  DOCUMENT
  WORKSPACE_ICON
}
