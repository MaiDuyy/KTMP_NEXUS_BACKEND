{
    "name": "file-service",
    "version": "1.0.0",
    "description": "File upload/storage service for OTT Chat",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.654.0",
        "@aws-sdk/s3-request-presigner": "^3.654.0",
        "@ott/shared": "file:../../packages/shared",
        "@prisma/client": "^5.20.0",
        "cloudinary": "^1.41.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "multer": "^1.4.5-lts.1",
        "nats": "^2.28.2",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "uuid": "^10.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "prisma": "^5.20.0",
        "supertest": "^7.0.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    }
}
