# ===========================================
# File Service Configuration
# ===========================================

# Server Config
PORT=3014
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:root@127.0.0.1:5432/chat_db?schema=public"

# Security
JWT_SECRET=your-jwt-secret-here

# NATS (Event Bus)
NATS_URL=nats://localhost:4222

# CORS
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Storage Provider Configuration
# ===========================================

# Provider selection: cloudinary | s3
STORAGE_PROVIDER=cloudinary

# -------------------------------------------
# Cloudinary (Primary - Recommended for images/media)
# Get credentials at: https://cloudinary.com/console
# -------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -------------------------------------------
# AWS S3 (Alternative - For large files/documents)
# -------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name

# ===========================================
# Optional: RabbitMQ (Job Queue)
# ===========================================

# Enable async job processing for documents
ENABLE_JOB_QUEUE=false
RABBITMQ_URL=amqp://localhost:5672

# ===========================================
# File Upload Limits
# ===========================================

# Max file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Max document size in bytes (default: 50MB for PDFs)
MAX_DOCUMENT_SIZE=52428800
