generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================================================
// MESSAGING SERVICE - Unified Schema (merged from chat-service + group-service)
// =======================================================================

// ================= CHAT / GROUP =================

model Chat {
  id           String            @id @default(uuid())
  isGroup      Boolean           @default(false)
  name         String?           @db.VarChar(255)
  avatar       String?           @db.VarChar(255)
  joinPolicy   ChatJoinPolicy    @default(PUBLIC)
  status       ChatStatus        @default(ACTIVE)
  isReadOnly   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  
  pinnedMessages Json?             @default("[]")
  
  workspaceId  String?
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id])
  
  participants ChatParticipant[]
  tasks        Task[]
  joinRequests JoinRequest[]
  messages     Message[]

  @@map("chat")
}

model ChatParticipant {
  id         String   @id @default(uuid())
  chatId     String
  accountId  String
  categoryId String?
  priority   Boolean? @default(true)
  readed     Boolean? @default(false)
  pin        Boolean  @default(false)
  notify     Boolean  @default(true)
  isMuted    Boolean  @default(false)
  hidden     Boolean  @default(false)
  clearedAt  DateTime?
  role       ChatParticipantRole @default(CHANNEL_MEMBER)

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id])

  @@unique([chatId, accountId])
  @@index([accountId])
  @@index([categoryId])
  @@map("chat_participant")
}

enum ChatParticipantRole {
  CHANNEL_OWNER
  CHANNEL_MODERATOR
  CHANNEL_MEMBER
  CHANNEL_GUEST
}

enum ChatJoinPolicy {
  PUBLIC
  PRIVATE
  APPROVAL
}

enum ChatStatus {
  ACTIVE
  DISSOLVED
  ARCHIVED
}

model JoinRequest {
  id        String            @id @default(uuid())
  chatId    String
  accountId String
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, accountId])
  @@index([accountId])
  @@map("join_request")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Task {
  id          String      @id @default(uuid())
  chatId      String
  creatorId   String
  title       String      @db.VarChar(255)
  description String?     @db.Text
  deadlineAt  DateTime?
  startAt     DateTime? @default(now())
  status      TaskStatus  @default(TODO)
  isNotified  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  assignees   TaskAssignee[]

  @@index([chatId])
  @@index([deadlineAt])
  @@map("task")
}

model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  accountId String
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, accountId])
  @@index([accountId])
  @@map("task_assignee")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// ================= CATEGORY =================

model Category {
  id        String            @id @default(uuid())
  name      String
  color     String
  accountId String
  
  chatParticipants ChatParticipant[]

  @@index([accountId])
  @@map("category")
}

// ================= MESSAGES =================

model Message {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String?
  type      String   @db.VarChar(20)
  time      DateTime @default(now())
  deletedBy String?  @db.Text
  destroy   Boolean  @default(false)
  pin       Boolean  @default(false)
  
  fileName  String?
  fileSize  String?
  fileType  String?
  
  replyToId String?
  
  // Thread support
  parentId     String?
  rootThreadId String?
  replyCount   Int            @default(0)
  
  // Edit tracking
  editedAt     DateTime?

  // Relations
  replyTo       Message?  @relation("ReplyRelation", fields: [replyToId], references: [id])
  replies       Message[] @relation("ReplyRelation")
  parent        Message?  @relation("ThreadRelation", fields: [parentId], references: [id])
  threadReplies Message[] @relation("ThreadRelation")
  reactions     Reaction[]
  mentions      Mention[]
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([replyToId])
  @@index([senderId])
  @@index([parentId])
  @@index([rootThreadId])
  @@map("message")
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  reaction  String   @db.VarChar(10)
  count     Int      @default(1)
  
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@map("reaction")
}

// ================= MENTION =================

model Mention {
  id          String   @id @default(uuid())
  messageId   String
  targetType  String   @db.VarChar(20)  // USER, HERE, CHANNEL
  targetId    String?
  createdAt   DateTime @default(now())
  
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([targetId])
  @@map("mention")
}

// ================= READ RECEIPTS =================

model ReadReceipt {
  id        String   @id @default(uuid())
  chatId    String
  userId    String
  messageId String
  readAt    DateTime @default(now())
  
  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("read_receipt")
}

// ================= POLL =================

model Poll {
  id        String   @id @default(uuid())
  chatId    String
  creatorId String
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  endsAt    DateTime?
  
  options   PollOption[]

  @@index([chatId])
  @@index([creatorId])
  @@map("poll")
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
  @@map("poll_option")
}

model PollVote {
  id           String   @id @default(uuid())
  pollOptionId String
  voterId      String
  createdAt    DateTime @default(now())
  
  option       PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)

  @@unique([pollOptionId, voterId])
  @@index([voterId])
  @@map("poll_vote")
}

// ================= WORKSPACE =================

model Workspace {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  icon        String?
  slug        String   @unique @db.VarChar(50)
  
  ownerId     String
  orgId       String?
  departmentId String?
  
  status      WorkspaceStatus @default(ACTIVE)
  isPublic         Boolean @default(false)
  allowGuestAccess Boolean @default(false)
  
  dissolvedAt DateTime?
  dissolvedBy String?
  retentionDays Int @default(30)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  channels    Channel[]
  chats       Chat[]
  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  categories  ChannelCategory[]
  
  @@index([ownerId])
  @@index([slug])
  @@index([departmentId])
  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  
  joinedAt    DateTime @default(now())
  invitedBy   String?
  
  leftAt      DateTime?
  leftReason  WorkspaceMemberLeaveReason?
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

enum WorkspaceRole {
  WORKSPACE_OWNER
  WORKSPACE_ADMIN
  WORKSPACE_MEMBER
  WORKSPACE_GUEST
}

enum WorkspaceStatus {
  ACTIVE
  DISSOLVED
  ARCHIVED
}

enum WorkspaceMemberLeaveReason {
  WORKSPACE_DISSOLVED
  SELF_LEFT
  KICKED
}

// ================= CHANNEL =================

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(500)
  topic       String?     @db.VarChar(250)
  
  type        ChannelType @default(PUBLIC)
  
  categoryId  String?
  position    Int         @default(0)
  
  isArchived  Boolean     @default(false)
  archivedAt  DateTime?
  archivedBy  String?
  
  isDefault   Boolean     @default(false)
  isReadOnly  Boolean     @default(false)
  
  creatorId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    ChannelCategory? @relation(fields: [categoryId], references: [id])
  members     ChannelMember[]
  permissions ChannelPermissionOverride[]
  
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([categoryId])
  @@index([type])
  @@map("channel")
}

enum ChannelType {
  PUBLIC
  PRIVATE
  GUEST
  ANNOUNCEMENT
}

model ChannelCategory {
  id          String   @id @default(uuid())
  workspaceId String
  name        String   @db.VarChar(50)
  position    Int      @default(0)
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels    Channel[]
  
  @@unique([workspaceId, name])
  @@map("channel_category")
}

model ChannelMember {
  id        String            @id @default(uuid())
  channelId String
  userId    String
  
  canPost   Boolean           @default(true)
  role      ChannelMemberRole @default(CHANNEL_MEMBER)
  
  isMuted   Boolean  @default(false)
  isPinned  Boolean  @default(false)
  
  joinedAt  DateTime @default(now())
  
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_member")
}

enum ChannelMemberRole {
  CHANNEL_OWNER
  CHANNEL_MODERATOR
  CHANNEL_MEMBER
  CHANNEL_GUEST
}

model ChannelPermissionOverride {
  id         String   @id @default(uuid())
  channelId  String
  
  targetType String
  targetId   String?
  
  allow      String[]
  deny       String[]
  
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  @@unique([channelId, targetType, targetId])
  @@map("channel_permission_override")
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  workspaceId String
  email       String?   // Email người được mời (nếu mời đích danh)
  token       String    @unique // Token bảo mật ngẫu nhiên
  role        WorkspaceRole @default(WORKSPACE_MEMBER)
  status      InviteStatus  @default(PENDING)
  
  expiresAt   DateTime?
  
  inviterId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([email])
  @@map("workspace_invite")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}
