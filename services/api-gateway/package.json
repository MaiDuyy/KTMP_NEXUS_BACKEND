{
    "name": "api-gateway",
    "version": "1.0.0",
    "description": "API Gateway for OTT Chat microservices",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --max-old-space-size=256  src/index.ts",
        "build": "tsc",
        "start": "node  --max-old-space-size=256  dist/index.js",
        "test": "jest",
        "test:voice": "tsx --test src/routes/proxy.voice.test.ts"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@ott/shared": "file:../../packages/shared",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "http-proxy-middleware": "^3.0.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "nats": "^2.28.2",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "rate-limit-redis": "^4.2.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.0.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0"
    }
}
