{
    "name": "chat-service",
    "version": "1.0.0",
    "description": "Chat/Messaging service for OTT Chat",
    "main": "dist/index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.3",
        "@grpc/proto-loader": "^0.8.0",
        "@ott/shared": "file:../../packages/shared",
        "@prisma/client": "^5.20.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.0.0",
        "ioredis": "^5.4.1",
        "nats": "^2.28.2",
        "pino": "^9.4.0",
        "pino-http": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "uuid": "^9.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^9.0.8",
        "grpc-tools": "^1.13.1",
        "prisma": "^5.20.0",
        "protoc": "^34.0.0",
        "supertest": "^7.2.2",
        "ts-proto": "^2.11.6",
        "tsx": "^4.19.1",
        "typescript": "^5.6.0",
        "vitest": "^4.0.18"
    }
}