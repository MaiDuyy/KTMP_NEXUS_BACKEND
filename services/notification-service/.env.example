# Database
DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=notification

# Server
PORT=3019
NODE_ENV=development
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000

# NATS
NATS_URL=nats://localhost:4222

# SMTP Email Config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=OTT Chat <noreply@ottchat.com>
