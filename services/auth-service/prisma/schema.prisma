generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= AUTH SERVICE MODELS =================
// Copy từ monolith src/prisma/schema.prisma, chỉ giữ models liên quan đến Auth

model Account {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(255)
  number         String    @unique
  email          String    @unique
  password       String
  avatar         String?
  status         String?
  birthDate      DateTime?
  location       String?
  gender         String    @db.VarChar(10)
  currentAvatars String?   @db.Text
  pushToken      String?   @db.VarChar(255)
  
  isOnline       Boolean   @default(false)
  isVerified     Boolean   @default(false)
  lastSeen       DateTime?
  role           AccountRole @default(EMPLOYEE)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  devices        LoggedInDevice[]
  otps           Otp[]
  auditLogs      AuditLog[]

  @@map("account")
}

model LoggedInDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  deviceName String
  platform   String
  accessToken String  @db.Text
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
  
  account    Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("logged_in_device")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String   @db.VarChar(6)
  type      OtpType  @default(VERIFY_EMAIL)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  account   Account? @relation(fields: [email], references: [email])

  @@index([email])
  @@index([email, code])
  @@map("otp")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  data      Json?
  ipAddress String?
  createdAt DateTime @default(now())

  account   Account  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_log")
}

// ================= ENUMS =================

enum AccountRole {
  SUPER_ADMIN      // Level 0 - Highest access
  ORG_ADMIN        // Level 1 - Organization management
  SECURITY_OFFICER // Level 2 - Audit & compliance
  WORKSPACE_MANAGER // Level 3 - Workspace management
  KNOWLEDGE_ADMIN  // Level 4 - Knowledge management
  AI_ADMIN         // Level 5 - AI configuration
  EMPLOYEE         // Level 10 - Standard user
  GUEST            // Level 20 - Limited access
}

enum OtpType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}
